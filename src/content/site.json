{
  "site": {
    "title": "一器千年｜龙泉青瓷社会实践成果展",
    "description": "从一器之形，走进千年窑火与今日龙泉。‘浙里的青瓷真好看’暑期社会实践成果展。",
    "team": "浙里的青瓷真好看",
    "updatedAt": "2026.08.20"
  },
  "history": [
    {
      "id": "origin",
      "index": "01",
      "stage": "源流",
      "period": "北宋前期",
      "title": "窑场初开，青色成形",
      "summary": "故宫博物院资料显示，龙泉窑始烧于北宋前期，窑址位于今浙江龙泉一带。早期生产为后来南宋至元的扩展提供了基础；这一阶段的重点，不是追认某件名器，而是看窑场、原料处理与成形技艺如何逐步汇成体系。",
      "visualImage": "./images/history/origin-baimiao.webp",
      "visualCaption": "北宋窑场 · 匠人拉坯成形",
      "sourceIds": ["S01"],
      "verifiedBy": "公开资料核对",
      "verifiedAt": "2026-08-10"
    },
    {
      "id": "peak",
      "index": "02",
      "stage": "鼎盛",
      "period": "南宋至元",
      "title": "粉青如玉，大器渐成",
      "summary": "南宋至元是龙泉窑的鼎盛期。南宋中期烧成著名的粉青釉，器类更为丰富；元代则在大型器物烧造上取得突出成就。温润的釉层、稳定的成形能力与不断扩大的窑业规模，共同塑造了龙泉青瓷成熟而多样的面貌。",
      "visualImage": "./images/history/peak-baimiao.webp",
      "visualCaption": "南宋窑场 · 修坯与施釉",
      "sourceIds": ["S01"],
      "verifiedBy": "公开资料核对",
      "verifiedAt": "2026-08-10"
    },
    {
      "id": "journey",
      "index": "03",
      "stage": "远播",
      "period": "12至15世纪",
      "title": "随舟越海，青色远行",
      "summary": "故宫博物院“天下龙泉”展览指出，12至15世纪间，龙泉青瓷由东亚传至西亚、非洲与东欧。海外需求也反过来影响器类、造型和装饰；它的远播并非一条想象的航线，而是由跨区域遗存与不同地区仿烧现象共同印证。",
      "visualImage": "./images/history/journey-baimiao.webp",
      "visualCaption": "元代窑场 · 大盘刻花装饰",
      "sourceIds": ["S02"],
      "verifiedBy": "公开资料核对",
      "verifiedAt": "2026-08-10"
    },
    {
      "id": "change",
      "index": "04",
      "stage": "转型",
      "period": "明代至明中期以后",
      "title": "明代续烧，窑业渐变",
      "summary": "明代龙泉窑继续烧造，并长期面向宫廷与广泛市场；至明代中期以后，故宫博物院资料记载其渐趋衰落。这里的“转型”并非窑火骤然终止，而是生产规模、市场方向与器物风格在更长时段中逐步发生改变。",
      "visualImage": "./images/history/change-baimiao.webp",
      "visualCaption": "明代窑场 · 装匣入窑",
      "sourceIds": ["S01", "S02"],
      "verifiedBy": "公开资料核对",
      "verifiedAt": "2026-08-10"
    },
    {
      "id": "revival",
      "index": "05",
      "stage": "复兴",
      "period": "2009年至今",
      "title": "列入非遗，手艺新生",
      "summary": "2009年，龙泉青瓷传统烧制技艺列入联合国教科文组织人类非物质文化遗产代表作名录。今天，备料、成形、修坯、施釉与烧成等核心工序仍由匠人延续；传统不只留在器物上，也作为可传授、可实践的知识进入当代生活。",
      "visualImage": "./images/history/revival-baimiao.webp",
      "visualCaption": "当代工坊 · 匠人验釉观色",
      "sourceIds": ["S03"],
      "verifiedBy": "公开资料核对",
      "verifiedAt": "2026-08-10"
    }
  ],
